# Copia este archivo como `.env` en la raíz (lo usa docker-compose).
# Para ejecutar Django fuera de Docker, cópialo como `backend/.env` y cambia los hosts
# `db` y `redis` por `localhost`.

# Django Settings
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria
# True solo en desarrollo
DEBUG=True
# Hosts separados por comas; añade la IP de tu red local si accedes desde otro equipo
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database Settings (for Docker)
POSTGRES_DB=chemstools_db
POSTGRES_USER=chemstools_user
POSTGRES_PASSWORD=cambia-esta-contraseña
DATABASE_URL=postgres://chemstools_user:cambia-esta-contraseña@db:5432/chemstools_db

# Redis (caché y rate limiting)
REDIS_URL=redis://redis:6379/1

# Rate limiting de la API (opcional)
# THROTTLE_RATE_ANON=60/min
# THROTTLE_RATE_USER=300/min
# THROTTLE_RATE_AUTH=10/min

# Monitorización (docker-compose.monitoring.yml)
GRAFANA_ADMIN_PASSWORD=cambia-esta-contraseña
